{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tazos/platform/evaluation.schema.json",
  "title": "TAZ OS Evaluation",
  "description": "Harness-level and per-specialist evaluation metrics, continuous improvement loop, and evaluation pipeline. Every workflow is measured. Every output is scored. See Volume 10.",
  "type": "object",
  "required": ["id", "name", "harness", "version", "harness_metrics", "specialist_metrics", "continuous_improvement", "evaluation_pipeline"],
  "properties": {
    "id": { "type": "string", "pattern": "^EVAL-[A-Z]+-[0-9]{3}$" },
    "name": { "type": "string" },
    "harness": { "type": "string", "description": "Owning harness ID" },
    "version": { "type": "string", "default": "1.0.0" },

    "harness_metrics": {
      "type": "array",
      "description": "Metrics measured at the harness level, not per-agent.",
      "items": {
        "type": "object",
        "required": ["name", "target", "frequency", "owner", "measurement"],
        "properties": {
          "name": { "type": "string" },
          "target": { "type": "string", "description": "Target value or threshold (e.g. '100%', '0', '<10 per day')." },
          "frequency": { "type": "string", "enum": ["realtime", "daily", "weekly", "monthly", "quarterly"] },
          "owner": { "type": "string", "description": "Agent or human ID that owns this metric." },
          "measurement": { "type": "string", "description": "How this metric is measured (method or formula)." }
        }
      }
    },

    "specialist_metrics": {
      "type": "object",
      "description": "Per-specialist evaluation scores. Keys are agent IDs. Each entry is a list of metric definitions with weights and optional hard-fail conditions.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "required": ["weight"],
              "description": "Metric with weight and optional hard-fail condition.",
              "properties": {
                "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                "hard_fail_if": { "type": "string", "description": "Condition that forces hard-fail regardless of score." }
              }
            },
            {
              "type": "object",
              "description": "Shorthand: metric name as key, weight as value object.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                  "hard_fail_if": { "type": "string" }
                }
              }
            }
          ]
        }
      }
    },

    "continuous_improvement": {
      "type": "object",
      "required": ["cycle", "improvement_sources", "metrics_tracked", "review_cadence"],
      "description": "The continuous improvement loop. After every significant workflow: compare planned vs actual, capture feedback, log failures, propose improvements.",
      "properties": {
        "cycle": {
          "type": "array",
          "description": "Ordered steps in the improvement cycle.",
          "items": {
            "type": "object",
            "required": ["step", "owner", "input", "output"],
            "properties": {
              "step": { "type": "string" },
              "owner": { "type": "string" },
              "input": { "type": "string" },
              "output": { "type": "string" },
              "artifacts_affected": { "type": "array", "items": { "type": "string" } },
              "artifact": { "type": "string" },
              "frequency": { "type": "string" }
            }
          }
        },
        "improvement_sources": {
          "type": "array",
          "description": "Sources of improvement signal.",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            ]
          }
        },
        "metrics_tracked": { "type": "array", "items": { "type": "string" } },
        "review_cadence": {
          "type": "object",
          "description": "What gets reviewed at each cadence level.",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "evaluation_pipeline": {
      "type": "object",
      "description": "How agent outputs are scored: agent completes → self-check → evaluator scores → pass/fail_hard/fail_soft/low_confidence.",
      "properties": {
        "1_agent_completes_task": {
          "type": "object",
          "properties": { "output": { "type": "string" } }
        },
        "2_self_check_passes": {
          "type": "object",
          "properties": { "condition": { "type": "string" } }
        },
        "3_evaluator_scores": {
          "type": "object",
          "properties": {
            "metrics": { "type": "string" },
            "hard_fail_check": { "type": "string" }
          }
        },
        "4_result": {
          "type": "object",
          "properties": {
            "pass": { "type": "string" },
            "fail_hard": { "type": "string" },
            "fail_soft": { "type": "string" },
            "low_confidence": { "type": "string" }
          }
        }
      }
    }
  }
}
