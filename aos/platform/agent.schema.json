{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos/platform/agent.schema.json",
  "title": "TAZ OS Agent",
  "description": "An autonomous worker that executes a well-defined capability within a harness. Agents execute work only — they do not own workflows, memory, scheduling, policy, or orchestration. See Volume 10.",
  "type": "object",
  "required": ["id", "name", "harness", "version", "status", "mission", "allowed_memory", "allowed_tools", "criticality"],
  "properties": {
    "id": { "type": "string", "pattern": "^AGT-[A-Z]+-[0-9A-Z]+$" },
    "name": { "type": "string" },
    "harness": { "type": "string", "description": "Owning harness ID" },
    "version": { "type": "string", "default": "1.0.0" },
    "status": { "type": "string", "enum": ["draft", "deployed", "production", "idle", "blocked", "retired"] },
    "criticality": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "mission": { "type": "string", "description": "Exactly one sentence." },
    "source_persona": {
      "oneOf": [
        { "type": "string", "description": "Path to existing persona .md file this agent re-homes. Null for greenfield." },
        { "type": "null" }
      ]
    },
    "persona_source": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "note": { "type": "string", "description": "Free-text notes about this agent's origin or special behavior." },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "description": "Type or entity name (e.g. string, markdown, list, financial_data, document, dashboard_snapshot)" },
          "required": { "type": "boolean" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["artifact", "event", "memory_write", "list", "string", "markdown", "recommendation", "analysis", "document"] },
          "becomes_artifact": { "type": "boolean", "default": true },
          "artifact_type": { "type": "string" },
          "classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted", "founder_only"] }
        }
      }
    },
    "allowed_memory": {
      "type": "object",
      "required": ["read", "write", "cannot_read"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "cannot_read": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "permission"],
        "properties": {
          "capability": { "type": "string", "description": "Capability requested, NOT provider (e.g. 'send_email', not 'Gmail API')" },
          "permission": { "type": "string", "enum": ["read", "write", "execute", "request_approval"] }
        }
      }
    },
    "reasoning_structure": {
      "type": "array",
      "description": "Fixed reasoning pipeline every agent follows.",
      "items": { "type": "string" }
    },
    "self_check": {
      "type": "array",
      "description": "Mandatory self-check questions before completion.",
      "items": { "type": "string" }
    },
    "evaluation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "weight"],
        "properties": {
          "metric": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "hard_fail_if": { "type": "string", "description": "Condition that forces hard-fail regardless of score" }
        }
      }
    },
    "failure_handling": {
      "type": "object",
      "description": "What this agent does on each failure mode. Values are agent-specific escalation targets, not just generic enum values.",
      "properties": {
        "missing_information": { "type": "string" },
        "tool_failure": { "type": "string" },
        "low_confidence": { "type": "string" },
        "policy_conflict": { "type": "string" }
      }
    },
    "financial_rules": {
      "type": "object",
      "description": "Domain-specific financial enforcement rules (used by CFO agent). Optional.",
      "properties": {
        "canonical_source": { "type": "string" },
        "generator": { "type": "string" },
        "hard_fails": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "correct_value"],
            "properties": {
              "description": { "type": "string" },
              "correct_value": { "type": "string" }
            }
          }
        },
        "scenario_b_activation": {
          "type": "object",
          "properties": {
            "condition": { "type": "string" },
            "authority": { "type": "string" }
          }
        },
        "constants_to_enforce": {
          "type": "object",
          "description": "Key-value pairs of financial constants this agent must enforce."
        }
      }
    },
    "risk_categories": {
      "type": "object",
      "description": "Risk categories monitored by this agent (used by Risk Officer). Optional.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "metrics": { "type": "array", "items": { "type": "string" } },
          "alert_thresholds": { "type": "object" }
        }
      }
    },
    "escalation_rules": {
      "type": "array",
      "description": "Escalation conditions and targets (used by Risk Officer, Dispatcher). Optional.",
      "items": { "type": "object" }
    },
    "models": {
      "type": "object",
      "properties": {
        "preferred": { "type": "string" },
        "fallback": { "type": "array", "items": { "type": "string" } }
      }
    },

    "planner_prompt": {
      "type": "string",
      "description": "Fixed reasoning prompt applied each cycle by planner agents."
    },
    "priority_framework": {
      "type": "object",
      "description": "Priority levels with criteria and constraints (used by planner).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "criteria": { "type": "array", "items": { "type": "string" } },
          "max_active": { "type": "integer" },
          "rule": { "type": "string" }
        }
      }
    },
    "delegation_heuristics": {
      "type": "array",
      "description": "Rules mapping task types to delegate agents (used by planner).",
      "items": {
        "type": "object",
        "required": ["if", "then"],
        "properties": {
          "if": { "type": "array", "items": { "type": "string" } },
          "then": {
            "type": "object",
            "properties": {
              "delegate_to": { "type": "string" },
              "escalate_to": { "type": "string" }
            }
          }
        }
      }
    },
    "routing_table": {
      "type": "object",
      "description": "Task routing table (used by dispatcher).",
      "properties": {
        "executive_internal": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task", "route_to", "sla"],
            "properties": {
              "task": { "type": "string" },
              "route_to": { "type": "string" },
              "sla": { "type": "string" },
              "escalation": { "type": "string" }
            }
          }
        },
        "cross_harness": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task", "route_to", "harness", "sla"],
            "properties": {
              "task": { "type": "string" },
              "route_to": { "type": "string" },
              "harness": { "type": "string" },
              "sla": { "type": "string" },
              "escalation": { "type": "string" }
            }
          }
        }
      }
    },
    "handoff_format": {
      "type": "string",
      "description": "Template for handoff files (used by dispatcher)."
    },
    "task_lifecycle": {
      "type": "object",
      "description": "Task state machine (used by dispatcher).",
      "properties": {
        "states": { "type": "array", "items": { "type": "string" } },
        "transitions": { "type": "array" },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "array",
      "description": "Anti-patterns this agent must never violate.",
      "items": { "type": "string" }
    },
    "daily_brief_format": {
      "type": "string",
      "description": "Template for daily brief output (used by chief-of-staff)."
    },
    "meeting_prep_pack_includes": {
      "type": "array",
      "description": "Items included in meeting prep packs (used by chief-of-staff).",
      "items": { "type": "string" }
    },
    "decision_log_format": {
      "type": "object",
      "description": "Required fields for decision log entries (used by chief-of-staff).",
      "additionalProperties": { "type": "string" }
    },
    "tracked_kpis": {
      "type": "object",
      "description": "KPIs tracked by this agent, grouped by domain (used by performance analyst).",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "drift_thresholds": {
      "type": "object",
      "description": "When to alert based on KPI drift (used by performance analyst).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    }
  }
}
