# AOS — Environment Variables Configuration
#
# Copy this file to .env and fill in your actual values.

# ============================================================================
# AUTHENTICATION
# ============================================================================
AOS_API_TOKEN=your-secure-token-here

# ============================================================================
# LLM PROVIDER
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
AOS_LLM_BASE_URL=http://localhost:20128
AOS_LLM_API_KEY=
NVIDIA_NIM_API_KEY=
AOS_PAID_TIER=
AOS_FREE_TIER=

# ============================================================================
# TRACING & OBSERVABILITY
# ============================================================================
AOS_TRACING=enabled
AOS_TRACING_BACKEND=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# VECTOR STORE — pgvector (CocoIndex RAG pipeline)
# ============================================================================

# [OPTIONAL] Postgres connection string for pgvector RAG index
# Required to enable CocoIndex incremental indexing of Netso venture docs
# Example (local Docker): postgresql://postgres:aos@localhost:5432/aos
# Start local instance: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=aos pgvector/pgvector:pg16
DATABASE_URL=

# ============================================================================
# PAPERCLIP CONTROL PLANE (Netso AI Company)
# ============================================================================
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_EXECUTIVE_ISSUE_ID=

# ============================================================================
# FOUNDER APPROVAL SECURITY
# ============================================================================
# Used only by the trusted approval service/runtime to sign action-bound
# approval tokens. Never expose this to an LLM, browser, task prompt, or
# untrusted agent input.
AOS_APPROVAL_SIGNING_SECRET=
# Runtime-injected JSON object mapping opaque approval IDs to signed tokens.
# This should come from a secret manager or trusted process environment.
AOS_APPROVAL_TOKENS_JSON=

# ============================================================================
# QUICK START
# ============================================================================
# 1. Set AOS_API_TOKEN and your chosen LLM credentials.
# 2. Deploy patched Paperclip and import companies/netso-energy with all
#    agents/routines paused.
# 3. Configure PAPERCLIP_API_URL/API_KEY/COMPANY_ID.
# 4. Configure AOS_APPROVAL_SIGNING_SECRET only in the trusted approval
#    service; do not give it to agents.
# 5. Inject AOS_APPROVAL_TOKENS_JSON only into the Paperclip AOS worker.
# 6. Run one CEO heartbeat in shadow mode before enabling other executives.
