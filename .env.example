# AOS — Environment Variables Configuration
# 
# Copy this file to .env and fill in your actual values.
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults provided.
#
# Generated: 2026-07-11

# ============================================================================
# AUTHENTICATION
# ============================================================================

# [REQUIRED] API token for WebSocket access to harness execution
# Generate a secure random token (e.g., openssl rand -hex 32)
AOS_API_TOKEN=your-secure-token-here

# ============================================================================
# LLM PROVIDER — PRIMARY (Anthropic)
# ============================================================================

# [REQUIRED] Anthropic Claude API key
# Get it from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# [OPTIONAL] Anthropic authentication token (alternative to API key)
# Used for specific auth flows
ANTHROPIC_AUTH_TOKEN=

# [OPTIONAL] Custom Anthropic API base URL
# Defaults to official Anthropic endpoint if not set
ANTHROPIC_BASE_URL=

# ============================================================================
# LLM PROVIDER — LOCAL/ROUTER (Ollama, vLLM, or local inference)
# ============================================================================

# [OPTIONAL] Local LLM router base URL
# Set this to use local/custom LLM providers instead of cloud
# Example: http://localhost:20128 (default), http://localhost:8000 (vLLM)
AOS_LLM_BASE_URL=http://localhost:20128

# [OPTIONAL] API key for local LLM router (if required)
# Leave empty if no authentication needed
AOS_LLM_API_KEY=

# ============================================================================
# LLM PROVIDER — NVIDIA NIM (Optional GPU-accelerated inference)
# ============================================================================

# [OPTIONAL] NVIDIA NIM API key
# Required only if using NVIDIA NIM for inference
# Get it from: https://docs.nvidia.com/nim/
NVIDIA_NIM_API_KEY=

# ============================================================================
# LLM PROVIDER — TIER CONFIGURATION
# ============================================================================

# [OPTIONAL] Enable paid tier for faster models
# Set to "1" to use paid/faster models, leave empty for free tier
# Free tier uses OpenRouter free models with round-robin
AOS_PAID_TIER=

# [OPTIONAL] Force free-tier model routing for subagents
# Set to "1" to route medium/low criticality agents to free model pool
# AOS_FREE_TIER: set to "1" to route medium/low agents to free model pool
AOS_FREE_TIER=

# ============================================================================
# TRACING & OBSERVABILITY (Langfuse integration)
# ============================================================================

# [OPTIONAL] Enable/disable tracing
# Values: "enabled" (default), "disabled"
AOS_TRACING=enabled

# [OPTIONAL] Tracing backend to use
# Values: "auto" (default), "langfuse", "json"
# - auto: Auto-detect available providers
# - langfuse: Send traces to Langfuse cloud
# - json: Log traces as JSON to stdout
AOS_TRACING_BACKEND=auto

# [OPTIONAL] Langfuse public API key
# Get it from: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=

# [OPTIONAL] Langfuse secret API key
# Get it from: https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=

# [OPTIONAL] Langfuse host
# Defaults to https://cloud.langfuse.com if not set
# Use this to point to self-hosted Langfuse instance
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. Minimal setup (development, free tier):
#    - Set AOS_API_TOKEN to any random string
#    - Set ANTHROPIC_API_KEY from https://console.anthropic.com
#    - Leave all other vars empty (defaults will be used)
#
# 2. Local LLM setup (using Ollama):
#    - Install Ollama: https://ollama.ai
#    - Run: ollama serve
#    - Set AOS_LLM_BASE_URL=http://localhost:11434
#    - Set ANTHROPIC_API_TOKEN to dummy value (won't be used)
#
# 3. Production setup:
#    - All REQUIRED variables set to secure values
#    - Tracing enabled (Langfuse)
#    - Paid tier enabled for faster inference
#
# ============================================================================
