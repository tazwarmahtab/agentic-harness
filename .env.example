# AOS — Environment Variables Configuration
#
# Copy this file to .env and fill in your actual values.
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults provided.

# ============================================================================
# AUTHENTICATION
# ============================================================================
AOS_API_TOKEN=your-secure-token-here

# ============================================================================
# LLM PROVIDER — PRIMARY (Anthropic)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# ============================================================================
# LLM PROVIDER — LOCAL/ROUTER
# ============================================================================
AOS_LLM_BASE_URL=http://localhost:20128
AOS_LLM_API_KEY=

# ============================================================================
# NVIDIA NIM (Optional)
# ============================================================================
NVIDIA_NIM_API_KEY=

# ============================================================================
# LLM PROVIDER — TIER CONFIGURATION
# ============================================================================
AOS_PAID_TIER=
AOS_FREE_TIER=

# ============================================================================
# TRACING & OBSERVABILITY
# ============================================================================
AOS_TRACING=enabled
AOS_TRACING_BACKEND=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================================
# VECTOR STORE — pgvector (CocoIndex RAG pipeline)
# ============================================================================

# [OPTIONAL] Postgres connection string for pgvector RAG index
# Required to enable CocoIndex incremental indexing of Netso venture docs
# Example (local Docker): postgresql://postgres:aos@localhost:5432/aos
# Start local instance: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=aos pgvector/pgvector:pg16
DATABASE_URL=

# ============================================================================
# PAPERCLIP CONTROL PLANE (Netso AI Company)
# ============================================================================
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
# Optional: stable Paperclip issue used as the executive control-loop sink.
# If empty, each AOS cycle creates a new issue instead.
PAPERCLIP_EXECUTIVE_ISSUE_ID=

# ============================================================================
# QUICK START
# ============================================================================
# 1. Set AOS_API_TOKEN and your chosen LLM credentials.
# 2. For Paperclip: start/deploy Paperclip, import companies/netso-energy,
#    keep agents/routines paused, then configure the three required Paperclip
#    variables above.
# 3. Set PAPERCLIP_EXECUTIVE_ISSUE_ID after creating a stable executive task
#    if you want cycle results appended to one control issue.
# 4. Enable autonomous routines only after approval/tool permissions and
#    evaluation gates are verified.
